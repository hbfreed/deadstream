#!/bin/bash
# Weekly: is there a newer Shairport Sync release than the one built from source? (Debian's updates don't
# reach it.) Logs to the journal and leaves a note shown at ssh login; rebuild with docs/airplay/build_ap2.sh.
note=/var/lib/shairport-update-check/note
mkdir -p "$(dirname "$note")"
installed=$(/usr/local/bin/shairport-sync -V 2>/dev/null | cut -d- -f1)
latest=$(curl -fsS -m 30 https://api.github.com/repos/mikebrady/shairport-sync/releases/latest | sed -n 's/.*"tag_name": *"\([^"]*\)".*/\1/p')
if [ -z "$installed" ] || [ -z "$latest" ]; then
  echo "shairport-update-check: could not compare (installed '$installed', latest '$latest')"; exit 0
fi
if [ "$installed" != "$latest" ]; then
  echo "Shairport Sync $latest is out (installed: $installed). Rebuild: docs/airplay/build_ap2.sh" | tee "$note"
else
  rm -f "$note"; echo "shairport-update-check: $installed is current"
fi
